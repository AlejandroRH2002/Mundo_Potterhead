# Private server configuration. Production reads system environment only.
DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
API_PORT=3001
API_HOST=127.0.0.1
COOKIE_SAME_SITE=Strict
# Enable only behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY=false
REGISTRATION_ENABLED=false
# Used only by explicit db:bootstrap. Remove from runtime after provisioning.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Public build-time frontend configuration. Never put secrets here.
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=

# Optional local Docker Compose database. Match these values in DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mundo_potterhead
POSTGRES_PORT=5432

# Bounded per-process Prisma pool. Total budget must include all replicas and jobs.
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=10
# Unset: TLS required/strict in production, disabled locally.
# DB_TLS_MODE=require
# Optional mounted CA certificate for managed PostgreSQL (Prisma sslcert).
# DB_SSL_CERT_PATH=/run/certs/database-ca.pem
# Direct (non-transaction-pooler) connection for production migrations only.
DIRECT_DATABASE_URL=

# Media: inline (2 MB) or s3 (10 MB direct signed POST).
MEDIA_STORAGE=inline
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
# Leave endpoint unset for AWS; compatible services must support signed POST policies.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Prefer an IAM workload role. Otherwise set private AWS credentials at runtime.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Public legal identity; configure real approved details before publishing.
VITE_LEGAL_NAME=
VITE_LEGAL_EMAIL=

# Public canonical HTTPS origin. Unset keeps builds non-indexable.
VITE_SITE_URL=
